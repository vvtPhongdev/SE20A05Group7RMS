@startuml
title RMS Package and Service Architecture
left to right direction
skinparam shadowing false
skinparam componentStyle rectangle
skinparam defaultFontName Arial

package "Client" {
  [React 19 + Vite SPA\nwebapp :3000] as WEB
}

package "HTTP Boundary" {
  [NestJS API Gateway\n/api/v1 :3001] as GW
  [JWT Guard + Roles Guard] as GUARDS
  [SSE Notification Bridge] as SSE
}

package "TCP Microservices" {
  [Identity :3010\nauth/users/org/dept] as ID
  [Recruiting :3011\nrequests/plans/tasks/jobs/reports/offers] as REC
  [Profiles :3012\ncandidate profile/documents] as PRO
  [Notification :3013\nin-app/email templates] as NOT
  [CV :3014\nCV metadata and lifecycle] as CV
  [Interview :3015\nschedule/panel/results] as INT
}

package "Shared packages" {
  [@wr/contracts\nenums + DTO schemas] as CONTRACTS
  [@wr/database\nPrisma client/schema] as DBPKG
  [@wr/config\nvalidated environment] as CONFIG
  [@wr/queue\nBullMQ contracts] as QUEUE
  [@wr/ai\nCV parse/extract/embed/search helpers] as AI
  [@wr/storage\nSupabase file helpers] as STORAGE
}

package "Async Runtime" {
  [Worker\nplain TypeScript process] as WORKER
  database "Redis 7\nBullMQ + refresh tokens" as REDIS
}

database "PostgreSQL 16 + pgvector\nshared database" as PG
cloud "Supabase Storage\nCV/avatar/posting media" as SUPA
cloud "Google Calendar / Meet" as GOOGLE
cloud "Email transport" as EMAIL
cloud "Gemini API (optional)\nCV structured extraction only" as GEMINI

WEB --> GW : HTTPS / JSON / SSE
GW --> GUARDS
GW --> SSE
GW --> ID : NestJS TCP
GW --> REC : NestJS TCP
GW --> PRO : NestJS TCP
GW --> NOT : NestJS TCP
GW --> CV : NestJS TCP
GW --> INT : NestJS TCP

ID --> PG
REC --> PG
PRO --> PG
NOT --> PG
CV --> PG
INT --> PG
WORKER --> PG

ID --> REDIS : refresh token state
NOT --> REDIS : email queue
REC --> REDIS : reminder/email jobs
WORKER --> REDIS : consume BullMQ jobs

GW --> STORAGE
STORAGE --> SUPA
ID --> GOOGLE
NOT --> EMAIL
WORKER --> AI
AI --> GEMINI : optional structured extraction

ID ..> CONTRACTS
REC ..> CONTRACTS
PRO ..> CONTRACTS
CV ..> CONTRACTS
INT ..> CONTRACTS
GW ..> CONTRACTS
ID ..> DBPKG
REC ..> DBPKG
PRO ..> DBPKG
CV ..> DBPKG
INT ..> DBPKG
WORKER ..> QUEUE

note bottom of AI
AI is a utility layer for CV processing and retrieval.
It must not make hiring decisions or score candidates autonomously.
end note
@enduml


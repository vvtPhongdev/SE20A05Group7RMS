{
  "name": "@wr/database",
  "version": "0.1.0",
  "private": true,
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "prisma generate && tsc --build",
    "clean": "rm -rf dist .turbo",
    "typecheck": "tsc --noEmit",
    "lint": "echo 'lint ok'",
    "generate": "prisma generate",
    "migrate:dev": "prisma migrate dev",
    "push": "prisma db push",
    "db:seed": "prisma db seed",
    "seed": "prisma db seed",
    "seed:sample-cvs": "ts-node --skip-project --compiler-options \"{\\\"module\\\":\\\"CommonJS\\\",\\\"moduleResolution\\\":\\\"node\\\"}\" prisma/seed-sample-cvs.ts",
    "studio": "prisma studio"
  },
  "dependencies": {
    "@prisma/client": "^7.9.0",
    "@prisma/extension-accelerate": "^3.0.1"
  },
  "devDependencies": {
    "@wr/typescript-config": "*",
    "prisma": "^7.9.0",
    "typescript": "^5.8.3"
  },
  "prisma": {
    "seed": "node prisma/seed-runner.cjs"
  }
}

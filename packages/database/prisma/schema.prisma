// ──────────────────────────────────────────────────────────────────
// Works Reruiter — Prisma Schema
// Reasoning-First Recruitment Management System
// ──────────────────────────────────────────────────────────────────

// generator erd {
//   provider = "prisma-erd-generator"
//   output   = "./erd.svg"
// }




generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL") 
  extensions = [vector]
}

// ═══════════════════════════════════════════════════════════════════
// Users & Organizations
// ═══════════════════════════════════════════════════════════════════

model User {
  id            String   @id @default(uuid())
  email         String   @unique
  displayName   String   @map("display_name")
  role          String   // UserRole enum
  passwordHash  String?  @map("password_hash")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  organizationMemberships  OrganizationMember[]
  candidateProfile         CandidateProfile?
  documents                Document[]
  applications             Application[]
  invitesSent              Invite[]                @relation("InvitesSent")
  invitesReceived          Invite[]                @relation("InvitesReceived")
  reviewerFeedback         ReviewerFeedback[]
  departmentsHeaded        Department[]            @relation("DepartmentHead")
  approvalChainLevels      ApprovalChainLevel[]    @relation("ApprovalChainApprover")
  hiringRequestsAuthored   HiringRequest[]         @relation("HiringRequestAuthor")
  hiringRequestsApproved   HiringRequestApproval[] @relation("HiringRequestApprover")

  @@map("users")
}

model Organization {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  members        OrganizationMember[]
  roles          Role[]
  departments    Department[]
  approvalChains ApprovalChain[]
  hiringRequests HiringRequest[]

  @@map("organizations")
}

model OrganizationMember {
  id             String   @id @default(uuid())
  userId         String   @map("user_id")
  organizationId String   @map("organization_id")
  memberRole     String   @map("member_role") // OWNER, ADMIN, MEMBER
  createdAt      DateTime @default(now()) @map("created_at")

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId], map: "uq_org_members_user_org")
  @@map("organization_members")
}

// ═══════════════════════════════════════════════════════════════════
// Departments
// ═══════════════════════════════════════════════════════════════════

model Department {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  name           String
  code           String   // e.g. "ENG", "PRODUCT", "DESIGN"
  headUserId     String?  @map("head_user_id")
  parentId       String?  @map("parent_id")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  headUser       User?           @relation("DepartmentHead", fields: [headUserId], references: [id])
  parent         Department?     @relation("DepartmentHierarchy", fields: [parentId], references: [id])
  children       Department[]    @relation("DepartmentHierarchy")
  hiringRequests HiringRequest[]
  approvalChains ApprovalChain[]

  @@unique([organizationId, code], map: "uq_departments_org_code")
  @@index([organizationId], map: "idx_departments_organization")
  @@map("departments")
}

// ═══════════════════════════════════════════════════════════════════
// Approval Chains — Multi-Level Configurable
// ═══════════════════════════════════════════════════════════════════

model ApprovalChain {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  departmentId   String?  @map("department_id") // null = org-wide default
  name           String
  isDefault      Boolean  @default(false) @map("is_default")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  department   Department?         @relation(fields: [departmentId], references: [id])
  levels       ApprovalChainLevel[]

  @@index([organizationId], map: "idx_approval_chains_organization")
  @@map("approval_chains")
}

model ApprovalChainLevel {
  id              String @id @default(uuid())
  approvalChainId String @map("approval_chain_id")
  level           Int    // 1, 2, 3 — execution order
  approverUserId  String @map("approver_user_id")
  role            String // ApprovalLevel enum: LEVEL_1, LEVEL_2, LEVEL_3

  approvalChain ApprovalChain @relation(fields: [approvalChainId], references: [id], onDelete: Cascade)
  approverUser  User          @relation("ApprovalChainApprover", fields: [approverUserId], references: [id])

  @@unique([approvalChainId, level], map: "uq_approval_chain_level")
  @@map("approval_chain_levels")
}

// ═══════════════════════════════════════════════════════════════════
// Hiring Requests — Enterprise Entry Point
// ═══════════════════════════════════════════════════════════════════

model HiringRequest {
  id               String    @id @default(uuid())
  organizationId   String    @map("organization_id")
  departmentId     String    @map("department_id")
  requestedById    String    @map("requested_by_id") // Department Head
  title            String
  description      String?   @db.Text
  justification    String?   @db.Text
  headcount        Int       @default(1)
  priority         String    @default("NORMAL") // LOW, NORMAL, HIGH, URGENT
  workMode         String?   @map("work_mode") // WorkMode enum
  location         String?
  budgetRange      Json?     @map("budget_range") // JSONB { min, max, currency }
  targetStartDate  DateTime? @map("target_start_date")
  status           String    @default("DRAFT") // HiringRequestStatus enum
  currentLevel     Int       @default(0) @map("current_level")
  rejectionReason  String?   @map("rejection_reason") @db.Text
  revisionNotes    String?   @map("revision_notes") @db.Text
  submittedAt      DateTime? @map("submitted_at")
  approvedAt       DateTime? @map("approved_at")
  rejectedAt       DateTime? @map("rejected_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  organization Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  department   Department             @relation(fields: [departmentId], references: [id])
  requestedBy  User                   @relation("HiringRequestAuthor", fields: [requestedById], references: [id])
  approvals    HiringRequestApproval[]
  roles        Role[]

  @@index([organizationId], map: "idx_hiring_requests_organization")
  @@index([departmentId], map: "idx_hiring_requests_department")
  @@index([status], map: "idx_hiring_requests_status")
  @@index([requestedById], map: "idx_hiring_requests_requested_by")
  @@map("hiring_requests")
}

model HiringRequestApproval {
  id               String    @id @default(uuid())
  hiringRequestId  String    @map("hiring_request_id")
  approverUserId   String    @map("approver_user_id")
  level            Int
  decision         String    @default("PENDING") // PENDING, APPROVED, REJECTED, REVISION_REQUESTED
  comments         String?   @db.Text
  decidedAt        DateTime? @map("decided_at")
  createdAt        DateTime  @default(now()) @map("created_at")

  hiringRequest HiringRequest @relation(fields: [hiringRequestId], references: [id], onDelete: Cascade)
  approverUser  User          @relation("HiringRequestApprover", fields: [approverUserId], references: [id])

  @@unique([hiringRequestId, approverUserId, level], map: "uq_hiring_approval_request_user_level")
  @@index([hiringRequestId], map: "idx_hiring_approvals_request")
  @@map("hiring_request_approvals")
}

// ═══════════════════════════════════════════════════════════════════
// Roles & Job Descriptions
// ═══════════════════════════════════════════════════════════════════

model Role {
  id               String   @id @default(uuid())
  organizationId   String   @map("organization_id")
  hiringRequestId  String?  @map("hiring_request_id") // source request (nullable for legacy roles)
  title            String
  description      String?  @db.Text
  workMode         String?  @map("work_mode") // WorkMode enum
  location         String?
  isActive         Boolean  @default(true) @map("is_active")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  organization       Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  hiringRequest      HiringRequest?      @relation(fields: [hiringRequestId], references: [id])
  jdDocuments        Document[]           @relation("RoleJdDocuments")
  jobCapabilityModel JobCapabilityModel?
  applications       Application[]
  invites            Invite[]

  @@index([organizationId], map: "idx_roles_organization_id")
  @@map("roles")
}

model JobCapabilityModel {
  id               String   @id @default(uuid())
  roleId           String   @unique @map("role_id")
  sourceDocumentId String   @map("source_document_id")
  capabilities     Json     // JSONB — extracted capability graph
  hardConstraints  Json?    @map("hard_constraints") // JSONB
  version          Int      @default(1)
  createdAt        DateTime @default(now()) @map("created_at")

  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@map("job_capability_models")
}

// ═══════════════════════════════════════════════════════════════════
// Candidate Profiles
// ═══════════════════════════════════════════════════════════════════

model CandidateProfile {
  id                String   @id @default(uuid())
  userId            String   @unique @map("user_id")
  headline          String?
  summary           String?  @db.Text
  visibility        String   @default("REGISTERED_ONLY") // CandidateVisibility enum
  preferredWorkMode String?  @map("preferred_work_mode")
  preferredLocations Json?   @map("preferred_locations") // JSONB string array
  yearsOfExperience Int?     @map("years_of_experience")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  user                   User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  cvDocuments            Document[]              @relation("CandidateCvDocuments")
  candidateCapabilityModel CandidateCapabilityModel?
  applications           Application[]

  @@map("candidate_profiles")
}

model CandidateCapabilityModel {
  id                 String   @id @default(uuid())
  candidateProfileId String   @unique @map("candidate_profile_id")
  sourceDocumentId   String   @map("source_document_id")
  capabilities       Json     // JSONB — extracted capabilities
  version            Int      @default(1)
  createdAt          DateTime @default(now()) @map("created_at")

  candidateProfile CandidateProfile @relation(fields: [candidateProfileId], references: [id], onDelete: Cascade)

  @@map("candidate_capability_models")
}

// ═══════════════════════════════════════════════════════════════════
// Documents (CV & JD)
// ═══════════════════════════════════════════════════════════════════

model Document {
  id               String   @id @default(uuid())
  uploadedById     String   @map("uploaded_by_id")
  documentType     String   @map("document_type") // DocumentType enum
  fileName         String   @map("file_name")
  mimeType         String   @map("mime_type")
  fileSizeBytes    Int      @map("file_size_bytes")
  storagePath      String?  @map("storage_path")
  state            String   @default("PENDING") // DocumentState enum
  parsedContent    String?  @map("parsed_content") @db.Text
  parseError       String?  @map("parse_error")
  version          Int      @default(1)
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  uploadedBy       User              @relation(fields: [uploadedById], references: [id])
  role             Role?             @relation("RoleJdDocuments", fields: [roleId], references: [id])
  roleId           String?           @map("role_id")
  candidateProfile CandidateProfile? @relation("CandidateCvDocuments", fields: [candidateProfileId], references: [id])
  candidateProfileId String?         @map("candidate_profile_id")
  evidenceRecords  EvidenceRecord[]

  @@index([uploadedById], map: "idx_documents_uploaded_by")
  @@index([state], map: "idx_documents_state")
  @@map("documents")
}

// ═══════════════════════════════════════════════════════════════════
// Applications & Invites
// ═══════════════════════════════════════════════════════════════════

model Application {
  id                 String   @id @default(uuid())
  roleId             String   @map("role_id")
  candidateProfileId String   @map("candidate_profile_id")
  applicantUserId    String   @map("applicant_user_id")
  status             String   @default("DRAFT") // ApplicationStatus enum
  coverNote          String?  @map("cover_note") @db.Text
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  role             Role             @relation(fields: [roleId], references: [id])
  candidateProfile CandidateProfile @relation(fields: [candidateProfileId], references: [id])
  applicantUser    User             @relation(fields: [applicantUserId], references: [id])
  evaluationRuns   EvaluationRun[]
  candidatePackets CandidatePacket[]

  @@unique([roleId, candidateProfileId], map: "uq_applications_role_candidate")
  @@index([status], map: "idx_applications_status")
  @@map("applications")
}

model Invite {
  id                 String   @id @default(uuid())
  roleId             String   @map("role_id")
  sentByUserId       String   @map("sent_by_user_id")
  candidateUserId    String   @map("candidate_user_id")
  status             String   @default("PENDING") // InviteStatus enum
  message            String?  @db.Text
  expiresAt          DateTime? @map("expires_at")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  role          Role @relation(fields: [roleId], references: [id])
  sentByUser    User @relation("InvitesSent", fields: [sentByUserId], references: [id])
  candidateUser User @relation("InvitesReceived", fields: [candidateUserId], references: [id])

  @@unique([roleId, candidateUserId], map: "uq_invites_role_candidate")
  @@map("invites")
}

// ═══════════════════════════════════════════════════════════════════
// Evaluation — Immutable Runs
// ═══════════════════════════════════════════════════════════════════

model EvaluationRun {
  id               String   @id @default(uuid())
  applicationId    String   @map("application_id")
  state            String   @default("PENDING") // EvaluationState enum
  readinessLabel   String?  @map("readiness_label") // ReadinessLabel enum (deterministic)
  idempotencyKey   String   @unique @map("idempotency_key")
  sourceSnapshot   Json?    @map("source_snapshot") // JSONB — versioned inputs
  ruleConfigVersion String? @map("rule_config_version")
  errorMessage     String?  @map("error_message")
  startedAt        DateTime? @map("started_at")
  completedAt      DateTime? @map("completed_at")
  createdAt        DateTime @default(now()) @map("created_at")

  application      Application       @relation(fields: [applicationId], references: [id])
  evidenceRecords  EvidenceRecord[]
  gapFindings      GapFinding[]
  explanationBoxes ExplanationBox[]
  interviewFocusItems InterviewFocusItem[]
  reviewerFeedback ReviewerFeedback[]

  @@index([applicationId], map: "idx_evaluation_runs_application")
  @@index([state], map: "idx_evaluation_runs_state")
  @@map("evaluation_runs")
}

// ═══════════════════════════════════════════════════════════════════
// Evidence Records — Provenance-First
// ═══════════════════════════════════════════════════════════════════

model EvidenceRecord {
  id               String   @id @default(uuid())
  evaluationRunId  String   @map("evaluation_run_id")
  sourceDocumentId String?  @map("source_document_id")
  evidenceType     String   @map("evidence_type") // EvidenceType enum
  content          String   @db.Text
  confidence       Float?
  sourceLocations  Json     @default("[]") @map("source_locations") // JSONB SourceLocation[]
  metadata         Json?    // JSONB
  createdAt        DateTime @default(now()) @map("created_at")

  evaluationRun  EvaluationRun @relation(fields: [evaluationRunId], references: [id], onDelete: Cascade)
  sourceDocument Document?     @relation(fields: [sourceDocumentId], references: [id])

  @@index([evaluationRunId], map: "idx_evidence_records_evaluation_run")
  @@index([sourceDocumentId], map: "idx_evidence_records_source_document")
  @@index([evidenceType], map: "idx_evidence_records_type")
  @@map("evidence_records")
}

// ═══════════════════════════════════════════════════════════════════
// Gap Findings
// ═══════════════════════════════════════════════════════════════════

model GapFinding {
  id              String   @id @default(uuid())
  evaluationRunId String   @map("evaluation_run_id")
  gapType         String   @map("gap_type") // GapType enum
  severity        String   // GapSeverity enum
  description     String   @db.Text
  requiredBy      String?  @map("required_by") // reference to JCM capability
  suggestedRampUp String?  @map("suggested_ramp_up")
  sourceLocations Json     @default("[]") @map("source_locations") // JSONB
  createdAt       DateTime @default(now()) @map("created_at")

  evaluationRun EvaluationRun @relation(fields: [evaluationRunId], references: [id], onDelete: Cascade)

  @@index([evaluationRunId], map: "idx_gap_findings_evaluation_run")
  @@map("gap_findings")
}

// ═══════════════════════════════════════════════════════════════════
// Explanation & Interview Focus (LLM narration output)
// ═══════════════════════════════════════════════════════════════════

model ExplanationBox {
  id              String   @id @default(uuid())
  evaluationRunId String   @map("evaluation_run_id")
  section         String   // e.g. "strengths", "gaps", "risk_summary"
  content         String   @db.Text
  sourceLocations Json     @default("[]") @map("source_locations") // JSONB
  createdAt       DateTime @default(now()) @map("created_at")

  evaluationRun EvaluationRun @relation(fields: [evaluationRunId], references: [id], onDelete: Cascade)

  @@index([evaluationRunId], map: "idx_explanation_boxes_evaluation_run")
  @@map("explanation_boxes")
}

model InterviewFocusItem {
  id              String   @id @default(uuid())
  evaluationRunId String   @map("evaluation_run_id")
  area            String   // capability area to probe
  rationale       String   @db.Text
  suggestedQuestions Json? @map("suggested_questions") // JSONB string[]
  priority        Int      @default(0)
  sourceLocations Json     @default("[]") @map("source_locations") // JSONB
  createdAt       DateTime @default(now()) @map("created_at")

  evaluationRun EvaluationRun @relation(fields: [evaluationRunId], references: [id], onDelete: Cascade)

  @@index([evaluationRunId], map: "idx_interview_focus_evaluation_run")
  @@map("interview_focus_items")
}

// ═══════════════════════════════════════════════════════════════════
// Reviewer Feedback
// ═══════════════════════════════════════════════════════════════════

model ReviewerFeedback {
  id              String   @id @default(uuid())
  evaluationRunId String   @map("evaluation_run_id")
  reviewerUserId  String   @map("reviewer_user_id")
  rating          Int?     // optional numeric rating
  comments        String?  @db.Text
  decision        String?  // ADVANCE, HOLD, REJECT
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  evaluationRun EvaluationRun @relation(fields: [evaluationRunId], references: [id], onDelete: Cascade)
  reviewerUser  User          @relation(fields: [reviewerUserId], references: [id])

  @@unique([evaluationRunId, reviewerUserId], map: "uq_reviewer_feedback_run_user")
  @@map("reviewer_feedback")
}

// ═══════════════════════════════════════════════════════════════════
// Candidate Packets
// ═══════════════════════════════════════════════════════════════════

model CandidatePacket {
  id            String   @id @default(uuid())
  applicationId String   @map("application_id")
  format        String   @default("PDF") // PDF, JSON
  storagePath   String?  @map("storage_path")
  generatedAt   DateTime @default(now()) @map("generated_at")
  metadata      Json?    // JSONB — packet contents summary

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId], map: "idx_candidate_packets_application")
  @@map("candidate_packets")
}

// ═══════════════════════════════════════════════════════════════════
// Skill Knowledge Graph
// ═══════════════════════════════════════════════════════════════════

model SkillNode {
  id        String   @id @default(uuid())
  name      String   @unique
  aliases   Json     @default("[]")          // JSONB string[] — alternate names
  category  String                            // SkillCategory enum
  parentId  String?  @map("parent_id")
  metadata  Json?                             // JSONB — extra info (description, weight)
  createdAt DateTime @default(now()) @map("created_at")

  parent    SkillNode?  @relation("SkillHierarchy", fields: [parentId], references: [id])
  children  SkillNode[] @relation("SkillHierarchy")
  edgesFrom SkillEdge[] @relation("SkillEdgeSource")
  edgesTo   SkillEdge[] @relation("SkillEdgeTarget")

  @@index([category], map: "idx_skill_nodes_category")
  @@map("skill_nodes")
}

model SkillEdge {
  id           String @id @default(uuid())
  sourceId     String @map("source_id")
  targetId     String @map("target_id")
  relationship String // SkillRelationship enum: IS_A, PART_OF, RELATED_TO, VARIANT_OF, REQUIRES
  weight       Float  @default(1.0)

  source SkillNode @relation("SkillEdgeSource", fields: [sourceId], references: [id], onDelete: Cascade)
  target SkillNode @relation("SkillEdgeTarget", fields: [targetId], references: [id], onDelete: Cascade)

  @@unique([sourceId, targetId, relationship], map: "uq_skill_edges")
  @@map("skill_edges")
}

// ═══════════════════════════════════════════════════════════════════
// Evidence Embeddings (pgvector)
// ═══════════════════════════════════════════════════════════════════

model EvidenceEmbedding {
  id               String   @id @default(uuid())
  evidenceRecordId String   @unique @map("evidence_record_id")
  textHash         String   @map("text_hash")
  model            String   @default("all-MiniLM-L6-v2")
  createdAt        DateTime @default(now()) @map("created_at")

  // NOTE: The `embedding` column (vector(384)) is managed via raw SQL migration
  // because Prisma doesn't natively support pgvector types.
  // Migration: ALTER TABLE evidence_embeddings ADD COLUMN embedding vector(384);
  // Index:     CREATE INDEX idx_evidence_embeddings_vector ON evidence_embeddings
  //            USING ivfflat (embedding vector_cosine_ops) WITH (lists = 100);

  @@map("evidence_embeddings")
}

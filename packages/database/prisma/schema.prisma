// ──────────────────────────────────────────────────────────────────
// Works Reruiter — Prisma Schema
// Recruitment Workflow Management System (RMS)
// ──────────────────────────────────────────────────────────────────

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector]
}

// ═══════════════════════════════════════════════════════════════════
// Users & Organizations
// ═══════════════════════════════════════════════════════════════════

model User {
  id             String   @id @default(uuid())
  email          String   @unique(map: "uq_users_email")
  displayName    String   @map("display_name")
  role           String // UserRole enum
  passwordHash   String?  @map("password_hash")
  organizationId String   @map("organization_id")
  departmentId   String?  @map("department_id")
  phone          String?
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization      Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  department        Department?       @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  candidateProfile  CandidateProfile?
  departmentsHeaded Department[]      @relation("DepartmentHead")

  requestsCreated  RecruitmentRequest[] @relation("CreatedRequests")
  requestsReviewed RecruitmentRequest[] @relation("ReviewedRequests")
  requestsApproved RecruitmentRequest[] @relation("ApprovedRequests")
  approvalRecords  ApprovalRecord[]
  requestLogs      RequestLog[]
  plansCreated     OverallPlan[]        @relation("CreatedPlans")
  plansApproved    OverallPlan[]        @relation("ApprovedPlans")
  tasksAssigned    TaskPlan[]
  notifications    Notification[]
  emails           EmailLog[]
  offersGenerated  OfferLetter[]        @relation("GeneratedOffers")
  interviewResults InterviewResult[]

  @@index([organizationId], map: "idx_users_organization")
  @@index([departmentId], map: "idx_users_department")
  @@map("users")
}

model Organization {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique(map: "uq_organizations_slug")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  users       User[]
  departments Department[]

  @@map("organizations")
}

// ═══════════════════════════════════════════════════════════════════
// Departments
// ═══════════════════════════════════════════════════════════════════

model Department {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  name           String
  code           String // e.g. "ENG", "PRODUCT", "DESIGN"
  headUserId     String?  @map("head_user_id")
  parentId       String?  @map("parent_id")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  headUser     User?                @relation("DepartmentHead", fields: [headUserId], references: [id], onDelete: SetNull)
  parent       Department?          @relation("DepartmentHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children     Department[]         @relation("DepartmentHierarchy")
  users        User[]
  requests     RecruitmentRequest[]

  @@unique([organizationId, code], map: "uq_departments_org_code")
  @@index([organizationId], map: "idx_departments_organization")
  @@map("departments")
}

// ═══════════════════════════════════════════════════════════════════
// Recruitment Requests & Approvals
// ═══════════════════════════════════════════════════════════════════

model RecruitmentRequest {
  id                String   @id @default(uuid())
  departmentId      String   @map("department_id")
  createdById       String   @map("created_by_id") // Trưởng phòng ban
  position          String // Vị trí tuyển dụng
  headcount         Int // Số lượng tuyển dụng
  jobDescription    String   @map("job_description") @db.Text
  skillRequirements Json     @default("{}") @map("skill_requirements") // JSONB
  justification     String   @db.Text // Lý do tuyển dụng
  urgency           String // Urgency enum
  status            String   @default("DRAFT") // RecruitmentRequestStatus enum
  reviewedById      String?  @map("reviewed_by_id") // HR Manager review
  approvedById      String?  @map("approved_by_id") // Boss/Admin final approval
  rejectionReason   String?  @map("rejection_reason") @db.Text
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  department      Department          @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  createdBy       User                @relation("CreatedRequests", fields: [createdById], references: [id], onDelete: Cascade)
  reviewedBy      User?               @relation("ReviewedRequests", fields: [reviewedById], references: [id], onDelete: SetNull)
  approvedBy      User?               @relation("ApprovedRequests", fields: [approvedById], references: [id], onDelete: SetNull)
  approvalRecords ApprovalRecord[]
  logs            RequestLog[]
  overallPlan     OverallPlan?
  interviews      InterviewSchedule[]
  jobPosting      JobPosting?
  applications    Application[]
  offers          OfferLetter[]

  @@index([departmentId], map: "idx_recruitment_requests_department")
  @@index([createdById], map: "idx_recruitment_requests_created_by")
  @@index([status], map: "idx_recruitment_requests_status")
  @@map("recruitment_requests")
}

model JobPosting {
  id           String    @id @default(uuid())
  requestId    String    @unique @map("request_id")
  title        String
  description  String    @db.Text
  requirements Json      @default("{}") @map("requirements")
  visibility   String    @default("PRIVATE") // PUBLIC, PRIVATE
  status       String    @default("DRAFT") // DRAFT, PUBLISHED, CLOSED
  expireDate   DateTime? @map("expire_date")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  request RecruitmentRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId], map: "idx_job_postings_request")
  @@map("job_postings")
}

model ApprovalRecord {
  id         String   @id @default(uuid())
  requestId  String   @map("request_id")
  approverId String   @map("approver_id")
  decision   String // APPROVED, REJECTED, REVISION_NEEDED
  comments   String?  @db.Text
  decidedAt  DateTime @default(now()) @map("decided_at")

  request  RecruitmentRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  approver User               @relation(fields: [approverId], references: [id], onDelete: Cascade)

  @@index([requestId], map: "idx_approval_records_request")
  @@index([approverId], map: "idx_approval_records_approver")
  @@map("approval_records")
}

model RequestLog {
  id            String   @id @default(uuid())
  requestId     String   @map("request_id")
  action        String // STATUS_CHANGE, PLAN_SUBMITTED, etc.
  fromStatus    String?  @map("from_status")
  toStatus      String?  @map("to_status")
  performedById String   @map("performed_by_id")
  metadata      Json? // JSONB
  createdAt     DateTime @default(now()) @map("created_at")

  request     RecruitmentRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  performedBy User               @relation(fields: [performedById], references: [id], onDelete: Cascade)

  @@index([requestId], map: "idx_request_logs_request")
  @@index([performedById], map: "idx_request_logs_performed_by")
  @@map("request_logs")
}

// T-107: Generic audit trail for status transitions across plans, interviews,
// and CV screening (NFR-3 — full traceability). No FK constraints, since
// `performedById` may be a non-user actor such as `SYSTEM` or a worker job.
model AuditLog {
  id            String   @id @default(uuid())
  entityType    String   @map("entity_type") // PLAN, TASK_PLAN, INTERVIEW_SCHEDULE, INTERVIEW_RESULT, CV, CV_EMBEDDING
  entityId      String   @map("entity_id")
  action        String // e.g. PLAN_APPROVED, CV_UPLOADED, CV_PARSE_COMPLETED
  fromStatus    String?  @map("from_status")
  toStatus      String?  @map("to_status")
  performedById String?  @map("performed_by_id")
  reason        String?  @db.Text
  metadata      Json?
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([entityType, entityId], map: "idx_audit_logs_entity")
  @@map("audit_logs")
}

// ═══════════════════════════════════════════════════════════════════
// Campaign Plans
// ═══════════════════════════════════════════════════════════════════

model OverallPlan {
  id            String   @id @default(uuid())
  requestId     String   @unique(map: "uq_overall_plans_request") @map("request_id")
  startDate     DateTime @map("start_date")
  endDate       DateTime @map("end_date")
  status        String   @default("PENDING_APPROVAL") // PlanStatus enum
  approvedById  String?  @map("approved_by_id")
  revisionNotes String?  @map("revision_notes") @db.Text
  createdById   String   @map("created_by_id") // HR Manager
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  request    RecruitmentRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  approvedBy User?              @relation("ApprovedPlans", fields: [approvedById], references: [id], onDelete: SetNull)
  createdBy  User               @relation("CreatedPlans", fields: [createdById], references: [id], onDelete: Cascade)
  tasks      TaskPlan[]

  @@index([requestId], map: "idx_overall_plans_request")
  @@index([createdById], map: "idx_overall_plans_created_by")
  @@map("overall_plans")
}

model TaskPlan {
  id            String   @id @default(uuid())
  overallPlanId String   @map("overall_plan_id")
  taskType      String   @map("task_type") // TaskType enum
  assignedToId  String   @map("assigned_to_id") // HR Staff
  startDate     DateTime @map("start_date")
  endDate       DateTime @map("end_date")
  status        String   @default("PENDING") // TaskStatus enum
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  overallPlan OverallPlan @relation(fields: [overallPlanId], references: [id], onDelete: Cascade)
  assignedTo  User        @relation(fields: [assignedToId], references: [id], onDelete: Cascade)

  @@index([overallPlanId], map: "idx_task_plans_overall_plan")
  @@index([assignedToId], map: "idx_task_plans_assigned_to")
  @@map("task_plans")
}

// ═══════════════════════════════════════════════════════════════════
// Candidates & CVs
// ═══════════════════════════════════════════════════════════════════

model CandidateProfile {
  id             String   @id @default(uuid())
  userId         String   @unique(map: "uq_candidate_profiles_user") @map("user_id")
  fullName       String   @map("full_name")
  email          String
  phone          String?
  summary        String?  @db.Text
  structuredData Json?    @map("structured_data") // JSONB Parsed CV data
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  cvDocuments  CandidateCV[]
  interviews   InterviewSchedule[]
  applications Application[]
  offers       OfferLetter[]

  @@map("candidate_profiles")
}

model CandidateCV {
  id              String    @id @default(uuid())
  candidateId     String    @map("candidate_id")
  fileName        String    @map("file_name")
  fileType        String    @map("file_type") // PDF / DOCX
  filePath        String    @map("file_path")
  rawText         String    @map("raw_text") @db.Text
  parsedAt        DateTime? @map("parsed_at")
  screeningStatus String    @default("PENDING") @map("screening_status") // PENDING | SHORTLISTED | REJECTED
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  candidate    CandidateProfile @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  cvEmbeddings CvEmbedding[]

  @@index([candidateId], map: "idx_candidate_cvs_candidate")
  @@map("candidate_cvs")
}

model CvEmbedding {
  id           String   @id @default(uuid())
  cvDocumentId String   @map("cv_document_id")
  chunkIndex   Int      @map("chunk_index")
  chunkText    String   @map("chunk_text") @db.Text
  createdAt    DateTime @default(now()) @map("created_at")

  cvDocument CandidateCV @relation(fields: [cvDocumentId], references: [id], onDelete: Cascade)

  // NOTE: pgvector column `embedding` (vector(384)) exists outside Prisma schema
  // and is added directly via raw SQL migration.

  @@index([cvDocumentId], map: "idx_cv_embeddings_document")
  @@map("cv_embeddings")
}

// ═══════════════════════════════════════════════════════════════════
// Interviews & Schedules
// ═══════════════════════════════════════════════════════════════════

model InterviewSchedule {
  id                  String            @id @default(uuid())
  requestId           String            @map("request_id")
  candidateId         String            @map("candidate_id")
  scheduledAt         DateTime          @map("scheduled_at")
  duration            Int // Duration in minutes
  location            String // Interview meeting room or URL
  interviewers        String[] // User IDs (interviewers)
  status              String            @default("SCHEDULED") // InterviewStatus enum
  /// Khuyến nghị tuyển dụng cuối cùng từ hội đồng/HR Manager (Recommend Hire, Recommend Reject, Hold for Further)
  finalRecommendation String?           @map("final_recommendation")
  /// Ý kiến tóm tắt/nhận xét tổng quan của HR Manager
  summaryNotes        String?           @map("summary_notes") @db.Text
  createdAt           DateTime          @default(now()) @map("created_at")
  updatedAt           DateTime          @updatedAt @map("updated_at")

  request   RecruitmentRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  candidate CandidateProfile   @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  results   InterviewResult[]

  @@index([requestId], map: "idx_interviews_request")
  @@index([candidateId], map: "idx_interviews_candidate")
  @@map("interview_schedules")
}

model InterviewResult {
  id            String            @id @default(uuid())
  interviewId   String            @map("interview_id")
  result        String // InterviewResult enum: PASS, FAIL
  notes         String?           @db.Text
  evaluatorId   String?           @map("evaluator_id")
  /// Điểm đánh giá kỹ thuật (thang điểm 10) từ thành viên hội đồng
  technical     Int?              @map("technical")
  /// Điểm đánh giá kỹ năng giao tiếp (thang điểm 10) từ thành viên hội đồng
  communication Int?              @map("communication")
  /// Điểm đánh giá độ phù hợp văn hóa (thang điểm 10) từ thành viên hội đồng
  culture       Int?              @map("culture")
  createdAt     DateTime          @default(now()) @map("created_at")
  updatedAt     DateTime          @updatedAt @map("updated_at")

  interview InterviewSchedule @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  evaluator User?             @relation(fields: [evaluatorId], references: [id], onDelete: SetNull)

  @@index([interviewId], map: "idx_interview_results_interview")
  @@index([evaluatorId], map: "idx_interview_results_evaluator")
  @@map("interview_results")
}

model OfferLetter {
  id             String    @id @default(uuid())
  requestId      String    @map("request_id")
  candidateId    String    @map("candidate_id")
  generatedById  String    @map("generated_by_id")
  positionTitle  String    @map("position_title")
  departmentName String    @map("department_name")
  compensation   String
  startDate      DateTime  @map("start_date")
  content        String    @db.Text
  status         String    @default("DRAFT")
  emailLogId     String?   @map("email_log_id")
  sentAt         DateTime? @map("sent_at")
  respondedAt    DateTime? @map("responded_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  request     RecruitmentRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  candidate   CandidateProfile   @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  generatedBy User               @relation("GeneratedOffers", fields: [generatedById], references: [id], onDelete: Restrict)

  @@unique([requestId, candidateId], map: "uq_offer_letters_request_candidate")
  @@index([requestId], map: "idx_offer_letters_request")
  @@index([candidateId], map: "idx_offer_letters_candidate")
  @@index([status], map: "idx_offer_letters_status")
  @@map("offer_letters")
}

// ═══════════════════════════════════════════════════════════════════
// System Notifications & Logs
// ═══════════════════════════════════════════════════════════════════

model Notification {
  id                String   @id @default(uuid())
  userId            String   @map("user_id")
  type              String // NotificationType enum
  title             String
  body              String   @db.Text
  isRead            Boolean  @default(false) @map("is_read")
  relatedEntityId   String?  @map("related_entity_id")
  relatedEntityType String?  @map("related_entity_type")
  createdAt         DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "idx_notifications_user")
  @@map("notifications")
}

model EmailLog {
  id           String    @id @default(uuid())
  userId       String?   @map("user_id")
  toEmail      String    @map("to_email")
  subject      String
  body         String    @db.Text
  status       String // EmailStatus enum: PENDING, SENT, FAILED
  errorMessage String?   @map("error_message") @db.Text
  sentAt       DateTime? @map("sent_at")
  createdAt    DateTime  @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId], map: "idx_email_logs_user")
  @@map("email_logs")
}

model Application {
  id          String   @id @default(uuid())
  requestId   String   @map("request_id")
  candidateId String   @map("candidate_id")
  status      String   @default("SUBMITTED") // e.g. SUBMITTED, SCREENING, INTERVIEWING, OFFER_EXTENDED, OFFER_ACCEPTED, REJECTED
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  request   RecruitmentRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  candidate CandidateProfile   @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@unique([requestId, candidateId], map: "uq_applications_request_candidate")
  @@index([requestId], map: "idx_applications_request")
  @@index([candidateId], map: "idx_applications_candidate")
  @@map("applications")
}

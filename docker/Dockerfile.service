# Build from the repository root, for example:
# docker build --build-arg SERVICE=gateway -f docker/Dockerfile.service -t rms-gateway:local .
FROM node:22-bookworm-slim AS build

ARG SERVICE
WORKDIR /app

COPY . .
RUN npm ci --fetch-retries=5 --fetch-retry-mintimeout=2000 --fetch-retry-maxtimeout=30000
RUN npx turbo run build --filter=@wr/${SERVICE}
RUN npm prune --omit=dev

FROM node:22-bookworm-slim AS runtime

ARG SERVICE
ENV NODE_ENV=production \
    SERVICE=${SERVICE}
WORKDIR /app

COPY --from=build --chown=node:node /app/package.json /app/package-lock.json ./
COPY --from=build --chown=node:node /app/node_modules ./node_modules
COPY --from=build --chown=node:node /app/packages ./packages
COPY --from=build --chown=node:node /app/services/${SERVICE}/package.json ./services/${SERVICE}/package.json
COPY --from=build --chown=node:node /app/services/${SERVICE}/dist ./services/${SERVICE}/dist

USER node
CMD ["sh", "-c", "node services/${SERVICE}/dist/main.js"]

# Monolithic Multi-process Dockerfile for GCP Cloud Run
FROM node:22-bookworm-slim AS build
RUN apt-get update && apt-get install -y openssl ca-certificates && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY . .
RUN test -s packages/ai-models/rms-embedding-model/config.json \
  && test -s packages/ai-models/rms-embedding-model/tokenizer.json \
  && test -s packages/ai-models/rms-embedding-model/tokenizer_config.json \
  && test -s packages/ai-models/rms-embedding-model/onnx/model.onnx
RUN find . -name "*.tsbuildinfo" -type f -delete || true
RUN npm ci --fetch-retries=5 --fetch-retry-mintimeout=2000 --fetch-retry-maxtimeout=30000
RUN NODE_OPTIONS="--max-old-space-size=2048" npx turbo run build --filter=!@wr/webapp --concurrency=1
RUN npm prune --omit=dev && npm install --omit=dev --prefer-offline --no-audit
RUN ls -la node_modules/@wr/ || true
RUN ls -la packages/database/ || true
RUN ls -la packages/database/dist/ || true

FROM node:22-bookworm-slim AS runtime
RUN apt-get update && apt-get install -y openssl ca-certificates && rm -rf /var/lib/apt/lists/*

ENV NODE_ENV=production
ENV WR_EMBEDDING_MODEL_PATH=/app/packages/ai-models/rms-embedding-model
WORKDIR /app

# Copy package descriptors and pruned production node_modules
COPY --from=build --chown=node:node /app/package.json /app/package-lock.json ./
COPY --from=build --chown=node:node /app/node_modules ./node_modules

# Copy built packages and services
COPY --from=build --chown=node:node /app/packages ./packages
COPY --from=build --chown=node:node /app/services ./services

# Copy startup orchestrator script
COPY --from=build --chown=node:node /app/docker/start-monolith.sh ./docker/start-monolith.sh

# Ensure script is executable
RUN chmod +x ./docker/start-monolith.sh

USER node
EXPOSE 8080

CMD ["./docker/start-monolith.sh"]

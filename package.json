{
  "name": "works-reruiter",
  "version": "0.1.0",
  "packageManager": "npm@10.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "services/*",
    "packages/*",
    "webapp"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,mjs,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,mjs,json,md}\"",
    "test:e2e:roles": "node scripts/e2e-role-flow.mjs",
    "test:api:postman": "node scripts/run-postman-api-tests.mjs",
    "test:ui:roles": "node scripts/ui-role-smoke.mjs",
    "test:ui:e2e": "playwright test --project=chromium-desktop --project=chromium-mobile",
    "test:ui:e2e:use-cases": "playwright test e2e/use-cases --project=chromium-desktop --workers=1",
    "test:ui:e2e:desktop": "playwright test --project=chromium-desktop",
    "test:ui:e2e:cross-browser": "playwright test --project=chromium-desktop --project=webkit-desktop --workers=1",
    "test:ui:e2e:firefox": "playwright test --project=firefox-desktop --workers=1",
    "test:ui:e2e:headed": "playwright test --project=chromium-desktop --headed",
    "test:ui:e2e:report": "playwright show-report",
    "clean": "turbo run clean && rm -rf node_modules",
    "db:generate": "npm --workspace=@wr/database run generate",
    "db:migrate:dev": "npm --workspace=@wr/database run migrate:dev",
    "db:push": "npm --workspace=@wr/database run push",
    "db:seed": "npm --workspace=@wr/database run db:seed",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "dev:gateway": "npm --workspace=@wr/gateway run dev",
    "dev:identity": "npm --workspace=@wr/identity run dev",
    "dev:recruiting": "npm --workspace=@wr/recruiting run dev",
    "dev:profiles": "npm --workspace=@wr/profiles run dev",
    "dev:cv": "npm --workspace=@wr/cv run dev",
    "dev:notification": "npm --workspace=@wr/notification run dev",
    "dev:worker": "npm --workspace=@wr/worker run dev",
    "dev:interview": "npm --workspace=@wr/interview run dev",
    "dev:webapp": "npm --workspace=@wr/webapp run dev"
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "@mermaid-js/mermaid-cli": "^11.15.0",
    "@playwright/test": "^1.61.1",
    "@types/node": "^25.9.1",
    "docx": "^9.7.1",
    "eslint": "^9.20.0",
    "newman": "^6.2.2",
    "prettier": "^3.5.3",
    "prisma": "^7.9.0",
    "prisma-erd-generator": "^2.4.2",
    "turbo": "2.9.7",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.24.0"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@prisma/client": "^7.9.0",
    "@prisma/extension-accelerate": "^3.0.1",
    "@supabase/ssr": "^0.12.0",
    "@supabase/supabase-js": "^2.108.2",
    "@tailwindcss/vite": "^4.3.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "dotenv": "^16.6.1",
    "tailwindcss": "^4.3.0"
  }
}

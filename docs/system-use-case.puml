UC_CreateRequest ..> UC_SaveDraft : <<include>>
UC_EditResubmitRequest ..> UC_SubmitRequest : <<include>>
UC_CreateRequest ..> UC_SubmitRequest : <<extend>>
UC_DeletePendingRequest ..> UC_TrackRequest : <<extend>>
UC_ViewCampaignState ..> UC_TrackRequest : <<extend>>
UC_SubmitInterviewFeedback ..> UC_ViewDeptInterviews : <<extend>>
UC_ClaimRequest ..> UC_ViewRequestQueue : <<extend>>
UC_EditRequestForReview ..> UC_ViewRequestQueue : <<extend>>
UC_ReturnRequest ..> UC_ViewRequestQueue : <<extend>>
UC_ForwardRequest ..> UC_ViewRequestQueue : <<extend>>
UC_CreatePlan ..> UC_ViewCampaigns : <<extend>>
UC_UpdatePlanTasks ..> UC_CreatePlan : <<include>>
UC_SubmitPlan ..> UC_UpdatePlanTasks : <<include>>
UC_ResubmitPlan ..> UC_UpdatePlanTasks : <<include>>
UC_ManageJobPosting ..> UC_ViewCampaigns : <<extend>>
UC_ManageRecruitmentTasks ..> UC_ViewCampaigns : <<extend>>
UC_ViewCandidateCv ..> UC_HybridSearch : <<extend>>
UC_CollectCandidate ..> UC_ViewTalentPool : <<extend>>
UC_ScreenCv ..> UC_CollectCandidate : <<extend>>
UC_ScheduleInterview ..> UC_ScreenCv : <<extend>>
UC_ViewInterviewDetail ..> UC_ScheduleInterview : <<extend>>
UC_RecordInterviewResult ..> UC_ViewInterviewDetail : <<extend>>
UC_DecideRequest ..> UC_AdminRequestQueue : <<extend>>
UC_RequestRequestChanges ..> UC_AdminRequestQueue : <<extend>>
UC_DecidePlan ..> UC_AdminPlanQueue : <<extend>>
UC_MakeHiringDecision ..> UC_ViewInterviewResults : <<extend>>
UC_RequestCandidateInformation ..> UC_MakeHiringDecision : <<extend>>
UC_ManageOfferLetters ..> UC_MakeHiringDecision : <<include>>
UC_ManageUserAccess ..> UC_ManageUsers : <<include>>
UC_ViewDepartmentStats ..> UC_ViewAnnualReport : <<extend>>

@enduml

@startuml
title RMS - Use Case Diagram: Candidate Module

left to right direction
skinparam shadowing false
skinparam packageStyle rectangle
skinparam defaultFontName Arial

actor "Candidate" as Candidate

package "RMS - Candidate Self-Service" {
  package "Authentication and Account" {
    usecase "Đăng ký tài khoản" as UC_CandidateRegister
    usecase "Xác thực Email OTP" as UC_CandidateVerifyOtp
    usecase "Đăng nhập bằng Email/Password" as UC_CandidateLogin
    usecase "Đăng nhập với Google" as UC_CandidateGoogleLogin
    usecase "Quên / Đặt lại mật khẩu" as UC_CandidateResetPassword
    usecase "Đăng xuất hệ thống" as UC_CandidateLogout
  }

  package "Candidate Profile and CV" {
    usecase "Xem hồ sơ ứng viên" as UC_ViewProfile
    usecase "Cập nhật hồ sơ ứng viên" as UC_UpdateProfile
    usecase "Tải lên CV" as UC_UploadCv
    usecase "Thay thế CV hiện tại" as UC_ReplaceCv
    usecase "Xóa CV" as UC_DeleteCv
    usecase "Theo dõi trạng thái xử lý CV" as UC_TrackCvProcessing
  }

  package "Job Search and Application" {
    usecase "Xem danh sách việc làm" as UC_ViewJobs
    usecase "Xem chi tiết việc làm" as UC_ViewJobDetail
    usecase "Nộp hồ sơ ứng tuyển" as UC_SubmitApplication
    usecase "Theo dõi trạng thái ứng tuyển" as UC_TrackApplication
  }

  package "Interview, Offer and Notification" {
    usecase "Xem thông báo" as UC_CandidateNotifications
    usecase "Xem lịch và chi tiết phỏng vấn" as UC_ViewInterview
    usecase "Xem danh sách Offer" as UC_ViewOffers
    usecase "Xem chi tiết Offer Letter" as UC_ViewOfferDetail
    usecase "Chấp nhận Offer Letter" as UC_AcceptOffer
    usecase "Từ chối Offer Letter" as UC_DeclineOffer
  }
}

Candidate --> UC_CandidateRegister
Candidate --> UC_CandidateLogin

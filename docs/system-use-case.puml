@startuml
title RMS - Sơ đồ use case tổng quan hệ thống

left to right direction
skinparam shadowing false
skinparam packageStyle rectangle
skinparam defaultFontName Arial
skinparam ArrowColor #52606D
skinparam ActorBorderColor #0F766E
skinparam ActorFontColor #134E4A
skinparam UsecaseBorderColor #64748B
skinparam UsecaseBackgroundColor #FFFFFF
skinparam PackageBorderColor #94A3B8
skinparam PackageBackgroundColor #F8FAFC

actor "Quản trị viên\n(ADMIN)" as Admin
actor "Trưởng phòng ban\n(DEPARTMENT_HEAD)" as DeptHead
actor "Trưởng bộ phận HR\n(HR_LEADER)" as HR
actor "Ứng viên\n(CANDIDATE)" as Candidate

rectangle "RMS - Recruitment Management System" {
  package "Truy cập hệ thống" {
    usecase "Đăng nhập\n(email/mật khẩu hoặc Google)" as SYS_Login
    usecase "Đăng ký tài khoản\n(email + OTP hoặc Google)" as SYS_Register
    usecase "Khôi phục mật khẩu" as SYS_RecoverPassword
    usecase "Đăng xuất" as SYS_Logout
  }

  package "Nghiệp vụ Trưởng phòng ban" {
    usecase "Xem dashboard và\ntheo dõi tiến độ" as SYS_DeptDashboard
    usecase "Tạo, lưu nháp, gửi và\ntheo dõi yêu cầu tuyển dụng" as SYS_DeptRequests
    usecase "Xem lịch, xác nhận tham gia\nvà đánh giá phỏng vấn" as SYS_DeptInterviews
    usecase "Quản lý hồ sơ, thành viên và\ncài đặt phòng ban" as SYS_DeptSettings
  }

  package "Nghiệp vụ HR" {
    usecase "Tiếp nhận, chỉnh sửa và\nchuyển yêu cầu cho Admin" as SYS_HrReview
    usecase "Lập kế hoạch Campaign và\nquản lý task" as SYS_HrCampaign
    usecase "Soạn, đăng và đóng\ntin tuyển dụng" as SYS_HrPosting
    usecase "Quản lý Talent Pool, tìm kiếm\nvà sàng lọc ứng viên" as SYS_HrTalent
    usecase "Lập lịch và điều phối\nphỏng vấn" as SYS_HrSchedule
    usecase "Ghi nhận đánh giá và gửi\nđề xuất cuối cho Admin" as SYS_HrResults
    usecase "Xem báo cáo pipeline và\nquản lý thông báo" as SYS_HrReports
  }

  package "Nghiệp vụ Admin" {
    usecase "Xem dashboard điều hành" as SYS_AdminDashboard
    usecase "Duyệt / từ chối yêu cầu và\nkế hoạch Campaign" as SYS_AdminApproval
    usecase "Theo dõi toàn bộ yêu cầu,\nphân công HR và xuất dữ liệu" as SYS_AdminRequests
    usecase "Ra quyết định tuyển dụng,\ntạo Offer hoặc gửi từ chối" as SYS_AdminHiring
    usecase "Quản lý người dùng và\nquyền truy cập" as SYS_AdminUsers
    usecase "Cấu hình tổ chức, phòng ban,\nquy trình và báo cáo" as SYS_AdminGovernance
  }

  package "Nghiệp vụ Ứng viên" {
    usecase "Xem việc làm công khai và\nchi tiết tin tuyển dụng" as SYS_CandidateJobs
    usecase "Quản lý hồ sơ, ảnh đại diện\nvà CV" as SYS_CandidateProfile
    usecase "Ứng tuyển và theo dõi\npipeline hồ sơ" as SYS_CandidateApplications
    usecase "Xem, xác nhận, đổi lịch hoặc\nhủy phỏng vấn" as SYS_CandidateInterviews
    usecase "Xem và phản hồi Offer Letter" as SYS_CandidateOffers
    usecase "Đọc, đánh dấu và lưu trữ\nthông báo" as SYS_CandidateNotifications
  }
}

Admin --> SYS_Login
Admin --> SYS_RecoverPassword
Admin --> SYS_Logout
Admin --> SYS_AdminDashboard
Admin --> SYS_AdminApproval
Admin --> SYS_AdminRequests
Admin --> SYS_AdminHiring
Admin --> SYS_AdminUsers
Admin --> SYS_AdminGovernance

DeptHead --> SYS_Login
DeptHead --> SYS_Register
DeptHead --> SYS_RecoverPassword
DeptHead --> SYS_Logout
DeptHead --> SYS_DeptDashboard
DeptHead --> SYS_DeptRequests
DeptHead --> SYS_DeptInterviews
DeptHead --> SYS_DeptSettings

HR --> SYS_Login
HR --> SYS_Register
HR --> SYS_RecoverPassword
HR --> SYS_Logout
HR --> SYS_HrReview
HR --> SYS_HrCampaign
HR --> SYS_HrPosting
HR --> SYS_HrTalent
HR --> SYS_HrSchedule
HR --> SYS_HrResults
HR --> SYS_HrReports

Candidate --> SYS_Login
Candidate --> SYS_Register
Candidate --> SYS_RecoverPassword
Candidate --> SYS_Logout
Candidate --> SYS_CandidateJobs
Candidate --> SYS_CandidateProfile
Candidate --> SYS_CandidateApplications
Candidate --> SYS_CandidateInterviews
Candidate --> SYS_CandidateOffers
Candidate --> SYS_CandidateNotifications

note bottom of SYS_Register
  UI đăng ký hiện hỗ trợ HR Leader,
  Department Head và Candidate;
  không cho tự đăng ký tài khoản Admin.
end note

legend bottom
  Sơ đồ phản ánh chức năng đã được hiện thực trong route, UI và API hiện tại.
  Chi tiết nằm trong admin-use-case.puml, department-head-use-case.puml,
  hr-leader-use-case.puml và candidate-use-case.puml.
endlegend

@enduml

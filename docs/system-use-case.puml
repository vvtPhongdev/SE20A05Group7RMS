UC_ViewNotifications .> UC_UnreadCount : <<include>>
UC_MarkAllRead ..> UC_MarkRead : <<extend>>
UC_AnnualReport ..> UC_ExportReport : <<extend>>
UC_DepartmentReport ..> UC_ExportReport : <<extend>>
UC_TimeToHire ..> UC_ExportReport : <<extend>>
UC_PipelineReport ..> UC_ExportReport : <<extend>>

' External system associations
Worker -- UC_ParseCV
Worker -- UC_GenerateEmbedding
Worker -- UC_SendEmail
Queue -- UC_ParseCV
Queue -- UC_GenerateEmbedding
Queue -- UC_SendEmail
Email -- UC_SendEmail
Database -- UC_RequestLogs
Database -- UC_SearchCandidates
Database -- UC_EmailLog
Database -- UC_AnnualReport
Database -- UC_DepartmentReport
Database -- UC_TimeToHire
Database -- UC_PipelineReport

legend bottom
  |= Element |= Meaning |
  | Actor | Human or external participant |
  | Use case | System capability from RMS project |
  | <<include>> | Mandatory reused behavior |
  | <<extend>> | Conditional or optional behavior |
endlegend

@enduml

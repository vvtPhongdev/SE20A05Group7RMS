HR --> UC_ManageRecruitmentTasks
HR --> UC_ViewTalentPool
HR --> UC_HybridSearch
HR --> UC_CollectCandidate
HR --> UC_ScreenCv
HR --> UC_ScheduleInterview
HR --> UC_ViewInterviewDetail
HR --> UC_RecordInterviewResult
HR --> UC_ViewPipelineReport
HR --> UC_ManageHrNotifications

Admin --> UC_Login
Admin --> UC_GoogleLogin
Admin --> UC_ResetPassword
Admin --> UC_Logout
Admin --> UC_ViewNotifications
Admin --> UC_AdminRequestQueue
Admin --> UC_AdminPlanQueue
Admin --> UC_ViewAllRequests

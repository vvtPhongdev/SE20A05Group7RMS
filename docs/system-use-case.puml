@startuml
title RMS - Use Case Diagram: Common and Enterprise Modules

left to right direction
skinparam shadowing false
skinparam packageStyle rectangle
skinparam defaultFontName Arial

actor "Department Head" as DeptHead
actor "HR Leader" as HR
actor "Admin" as Admin

package "RMS - Recruitment Management System" {
  package "Common Authentication" {
    usecase "Đăng nhập bằng Email/Password" as UC_Login
    usecase "Đăng nhập với Google" as UC_GoogleLogin
    usecase "Đăng ký tài khoản" as UC_Register
    usecase "Xác thực Email OTP" as UC_VerifyOtp
    usecase "Quên / Đặt lại mật khẩu" as UC_ResetPassword
    usecase "Đăng xuất hệ thống" as UC_Logout
    usecase "Xem thông báo" as UC_ViewNotifications
  }

  package "Department Head - Recruitment Request" {
    usecase "Tạo yêu cầu tuyển dụng" as UC_CreateRequest
    usecase "Lưu bản nháp yêu cầu" as UC_SaveDraft
    usecase "Chỉnh sửa và gửi lại yêu cầu" as UC_EditResubmitRequest
    usecase "Gửi yêu cầu để HR duyệt" as UC_SubmitRequest
    usecase "Xem và theo dõi yêu cầu" as UC_TrackRequest
    usecase "Xem trạng thái Campaign Plan" as UC_ViewCampaignState
    usecase "Xóa yêu cầu đang chờ duyệt" as UC_DeletePendingRequest
    usecase "Xem lịch phỏng vấn phòng ban" as UC_ViewDeptInterviews
    usecase "Gửi phản hồi phỏng vấn" as UC_SubmitInterviewFeedback
    usecase "Cập nhật cấu hình phòng ban" as UC_UpdateDepartmentSettings
  }

  package "HR - Request Review and Campaign" {
    usecase "Nhận / claim yêu cầu tuyển dụng" as UC_ClaimRequest
    usecase "Xem hàng đợi duyệt yêu cầu" as UC_ViewRequestQueue
    usecase "Chỉnh sửa thông tin yêu cầu" as UC_EditRequestForReview
    usecase "Trả yêu cầu để chỉnh sửa" as UC_ReturnRequest
    usecase "Chuyển yêu cầu đến Admin" as UC_ForwardRequest
    usecase "Xem danh sách Campaign" as UC_ViewCampaigns
    usecase "Tạo Campaign Plan" as UC_CreatePlan
    usecase "Cập nhật task của Campaign" as UC_UpdatePlanTasks
    usecase "Gửi Campaign Plan để Admin duyệt" as UC_SubmitPlan
    usecase "Gửi lại Campaign Plan bị trả về" as UC_ResubmitPlan
    usecase "Quản lý Job Posting" as UC_ManageJobPosting
    usecase "Quản lý task tuyển dụng" as UC_ManageRecruitmentTasks
  }

  package "HR - Candidate and Interview Operations" {
    usecase "Xem Talent Pool" as UC_ViewTalentPool
    usecase "Tìm kiếm ứng viên Hybrid Search" as UC_HybridSearch
    usecase "Xem hồ sơ và CV ứng viên" as UC_ViewCandidateCv
    usecase "Thu thập ứng viên vào pipeline" as UC_CollectCandidate
    usecase "Sàng lọc CV" as UC_ScreenCv
    usecase "Lập lịch phỏng vấn" as UC_ScheduleInterview
    usecase "Xem chi tiết phỏng vấn" as UC_ViewInterviewDetail
    usecase "Ghi nhận kết quả phỏng vấn" as UC_RecordInterviewResult
    usecase "Xem báo cáo Recruitment Pipeline" as UC_ViewPipelineReport
    usecase "Quản lý thông báo HR" as UC_ManageHrNotifications
  }

  package "Admin - Approval, Governance and Reporting" {
    usecase "Xem hàng đợi duyệt Request" as UC_AdminRequestQueue
    usecase "Duyệt / từ chối Request" as UC_DecideRequest
    usecase "Yêu cầu chỉnh sửa Request" as UC_RequestRequestChanges
    usecase "Xem hàng đợi duyệt Campaign Plan" as UC_AdminPlanQueue
    usecase "Duyệt / từ chối Campaign Plan" as UC_DecidePlan
    usecase "Xem toàn bộ yêu cầu tuyển dụng" as UC_ViewAllRequests
    usecase "Xem kết quả phỏng vấn" as UC_ViewInterviewResults
    usecase "Ra quyết định tuyển dụng" as UC_MakeHiringDecision
    usecase "Yêu cầu thêm thông tin ứng viên" as UC_RequestCandidateInformation
    usecase "Quản lý Offer Letter" as UC_ManageOfferLetters
    usecase "Quản lý người dùng" as UC_ManageUsers
    usecase "Phân quyền và trạng thái tài khoản" as UC_ManageUserAccess
    usecase "Cấu hình tổ chức và phòng ban" as UC_ManageOrganizationSettings
    usecase "Xem báo cáo năm" as UC_ViewAnnualReport
    usecase "Xem thống kê theo phòng ban / Campaign" as UC_ViewDepartmentStats
  }
}


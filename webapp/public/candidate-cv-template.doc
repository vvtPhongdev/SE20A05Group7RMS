<html xmlns:o="urn:schemas-microsoft-com:office:office"
      xmlns:w="urn:schemas-microsoft-com:office:word"
      xmlns="http://www.w3.org/TR/REC-html40">
<head>
  <meta charset="utf-8">
  <meta name="ProgId" content="Word.Document">
  <meta name="Generator" content="Microsoft Word">
  <title>Candidate CV Template</title>
  <style>
    @page {
      size: A4;
      margin: 1.8cm;
    }

    body {
      color: #24343a;
      font-family: Arial, sans-serif;
      font-size: 10.5pt;
      line-height: 1.45;
    }

    h1 {
      margin: 0;
      color: #123f46;
      font-size: 24pt;
      text-transform: uppercase;
    }

    h2 {
      margin: 18pt 0 8pt;
      padding-bottom: 4pt;
      border-bottom: 2px solid #137c7c;
      color: #123f46;
      font-size: 12pt;
      text-transform: uppercase;
      letter-spacing: 0.5pt;
    }

    h3 {
      margin: 8pt 0 2pt;
      font-size: 11pt;
    }

    p {
      margin: 3pt 0;
    }

    ul {
      margin: 5pt 0 8pt 20pt;
    }

    .role {
      margin: 3pt 0 8pt;
      color: #137c7c;
      font-size: 13pt;
      font-weight: bold;
    }

    .contact {
      padding: 8pt;
      background: #eef7f6;
    }

    .hint {
      color: #6b7478;
      font-style: italic;
    }

    .rms-template-marker {
      color: #ffffff;
      font-size: 1pt;
      height: 0;
      line-height: 0;
      margin: 0;
      overflow: hidden;
    }

    .date {
      float: right;
      color: #56646a;
      font-weight: normal;
    }

    table {
      width: 100%;
      border-collapse: collapse;
    }

    td {
      padding: 3pt 8pt 3pt 0;
      vertical-align: top;
    }
  </style>
</head>
<body>
  <p class="rms-template-marker">RMS-CV-TEMPLATE: V1</p>
  <h1>Full Name:</h1>
  <p class="role">Professional Title:</p>

  <div class="contact">
    <table>
      <tr>
        <td><strong>Email:</strong> </td>
        <td><strong>Phone:</strong> </td>
      </tr>
      <tr>
        <td><strong>Address:</strong> </td>
        <td><strong>LinkedIn:</strong> </td>
      </tr>
      <tr>
        <td><strong>GitHub:</strong> </td>
        <td><strong>Portfolio:</strong> </td>
      </tr>
    </table>
  </div>

  <h2>Professional Summary</h2>
  <p><strong>Summary:</strong> </p>

  <h2>Technical Skills</h2>
  <p><strong>Programming languages:</strong> </p>
  <p><strong>Frameworks and libraries:</strong> </p>
  <p><strong>Databases and tools:</strong> </p>

  <h2>Soft Skills</h2>
  <p><strong>Soft skills:</strong> </p>

  <h2>Languages</h2>
  <p><strong>Languages:</strong> </p>

  <h2>Work Experience</h2>
  <h3>Position: </h3>
  <p>Company: </p>
  <p>Start date: </p>
  <p>End date: </p>
  <ul>
    <li>Achievement: </li>
  </ul>

  <h3>Position: </h3>
  <p>Company: </p>
  <p>Start date: </p>
  <p>End date: </p>
  <ul>
    <li>Achievement: </li>
  </ul>

  <h2>Education</h2>
  <h3>Degree: </h3>
  <p>Major: </p>
  <p>School / University: </p>
  <p>Start date: </p>
  <p>End date: </p>

  <h2>Additional Information</h2>
  <p><strong>Certifications:</strong> </p>
  <p><strong>Projects:</strong> </p>
  <p><strong>Activities:</strong> </p>
</body>
</html>

# ========================================
# Works Reruiter — Environment Variables
# ========================================
# Copy this file to .env and fill in values.

# Node
NODE_ENV=development

# PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/works_reruiter?schema=public

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# API
API_PORT=3001
API_CORS_ORIGIN=http://localhost:3000

# Web
NEXT_PUBLIC_API_URL=http://localhost:3001

# JWT (stub auth)
JWT_SECRET=dev-secret-change-in-production
JWT_EXPIRES_IN=7d

# Google Calendar / Meet OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_PROJECT_ID=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3001/api/v1/oauth2callback

# LLM (deferred — not needed for MVP scaffold)
# Gemini CV OCR and structured extraction.
# Required for scanned/image PDFs and Canva CVs; text documents retain a local fallback.
GEMINI_API_KEY=
GEMINI_CV_MODEL=gemini-3.5-flash

# Optional fallback when Gemini fails or the configured Gemini model is unavailable.
# OPENAI_CV_MODEL falls back to LLM_MODEL when set.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_CV_MODEL=gpt-5.5

# AI Embedding Runtime
# Leave WR_EMBEDDING_API_URL empty to use the local ONNX model in packages/ai-models.
# Set it to a Colab tunnel URL to generate embeddings on a cloud GPU runtime.
WR_EMBEDDING_API_URL=
WR_EMBEDDING_API_TOKEN=

# Supabase Storage
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_CV_BUCKET=CV-Storage
SUPABASE_AVATAR_BUCKET=avatars
SUPABASE_BANNER_BUCKET=Banner

# SMTP (for password reset)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Works Reruiter <noreply@worksreruiter.com>"

